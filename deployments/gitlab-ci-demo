stages:
  - build
  - test
  - publish
  - deploy

build:
  image: node:lts-slim
  cache:
    key: npm-build
    paths:
      - node_modules
  artifacts:
    expire_in: 2 hours
    paths:
      - dist
  stage: build
  before_script:
    - npm install
  script:
    - npm run build

scan:
  stage: test
  image: docker:stable
  allow_failure: true
  before_script:
    - apk add git bash --no-cache
    - git clone https://github.com/lukebond/microscanner-wrapper.git aquasec
    - chmod +x aquasec/scan.sh && chmod +x aquasec/grabjson.sh
  script:
    - docker build -t ${CI_REGISTRY_IMAGE}:latest .
    - cd aquasec && ./grabjson.sh ${CI_REGISTRY_IMAGE}:latest

docker-publish:
  stage: publish
  image: docker:stable
  before_script:
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $CI_REGISTRY
  script:
    - docker build -t ${CI_REGISTRY_IMAGE}:${CI_BUILD_TAG} .
    - docker tag ${CI_REGISTRY_IMAGE}:${CI_BUILD_TAG} ${CI_REGISTRY_IMAGE}:latest
    - docker push ${CI_REGISTRY_IMAGE}:${CI_BUILD_TAG}
    - docker push ${CI_REGISTRY_IMAGE}:latest
  only:
    - tags

deploy-production:
  stage: deploy
  image: bitnami/kubectl:latest
  environment:
    name: production
    url: ${PRODUCTION_HOST}
  variables:
    GIT_STRATEGY: none
  script:
    - kubectl set image deployment.v1.apps/${KUBE_NAME} ${KUBE_NAME}=${CI_REGISTRY_IMAGE}:${CI_BUILD_TAG} -n=${KUBE_NAMESPACE}
  only:
    - tags
